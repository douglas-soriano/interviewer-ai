# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://interviewer:interviewer@localhost:5432/interviewer

# openrouter or gemini
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=interviewer-ai

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
